# Copy this file to .env and fill in the values before running docker compose up.

# Postgres password (pick anything, just keep it consistent)
POSTGRES_PASSWORD=change-me

# Used to encrypt stored secrets (carrier API keys, Gmail app password, Discord webhook) at rest.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Port the app is exposed on, e.g. http://localhost:8080
HOST_PORT=8080

# Nominatim (OpenStreetMap geocoding) asks that requests identify a contact per its usage policy.
NOMINATIM_USER_AGENT=self-hosted-package-tracker/1.0 (your-email@example.com)
