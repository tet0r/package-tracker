# Copy this file to .env and fill in the values before running docker compose up.

# Postgres password (pick anything, just keep it consistent)
POSTGRES_PASSWORD=change-me

# Used to encrypt stored secrets (API keys, OAuth tokens) at rest.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Port the app is exposed on, e.g. http://localhost:8080
HOST_PORT=8080

# Must exactly match the "Authorized redirect URI" you set on the Google OAuth client
# (the in-app Gmail setup wizard shows you the exact value to use).
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Nominatim (OpenStreetMap geocoding) asks that requests identify a contact per its usage policy.
NOMINATIM_USER_AGENT=self-hosted-package-tracker/1.0 (your-email@example.com)
